<section>
  <span class="ek-eyebrow">Okul seçimi</span>
  <h1 class="ek-section-title">Okullar</h1>
  <p class="ek-section-copy">Çocuğunuzun okulunu seçin, sınıf listesine ulaşın ve tüm ihtiyaçları tek seferde sepete ekleyin.</p>

  <div class="ek-grid mt-8">
    <% @schools.each do |school| %>
      <article class="ek-card">
        <span class="ek-card-kicker">Onaylı okul</span>
        <h2 class="ek-card-title"><%= school.name %></h2>
        <p class="ek-muted"><%= school.address %></p>
        <div class="ek-pill-row mt-4">
          <span class="ek-pill">Tel: <%= school.phone %></span>
        </div>
        <div class="ek-actions mt-5">
          <%= link_to "Detay", school_path(school), class: "ek-secondary-button" %>
          <%= link_to "Sınıflar", classes_school_path(school), class: "ek-primary-button" %>
        </div>
      </article>
    <% end %>
  </div>
</section>
