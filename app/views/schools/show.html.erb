<section>
  <nav class="mb-5">
    <%= link_to "← Okullar", schools_path, class: "ek-card-link" %>
  </nav>

  <article class="ek-panel p-6 md:p-8">
    <span class="ek-eyebrow">Okul profili</span>
    <h1 class="ek-section-title"><%= @school.name %></h1>
    <p class="ek-section-copy">Okul bilgilerini inceleyin ve sınıf ihtiyaç listelerine geçin.</p>

    <div class="ek-grid mt-8">
      <div class="ek-card">
        <span class="ek-card-kicker">İletişim</span>
        <p class="font-bold mt-3"><%= @school.address %></p>
        <p class="ek-muted mt-2">Telefon: <%= @school.phone %></p>
        <p class="ek-muted">E-posta: <%= @school.email %></p>
      </div>
      <div class="ek-card">
        <span class="ek-card-kicker">Kurum</span>
        <p class="font-bold mt-3">Vergi No: <%= @school.tax_number %></p>
        <p class="ek-muted mt-2">Durum: <%= @school.status %></p>
      </div>
    </div>

    <div class="ek-actions mt-8">
      <%= link_to "Sınıfları Görüntüle", classes_school_path(@school), class: "ek-primary-button" %>
    </div>
  </article>
</section>
