<section>
  <nav class="mb-5">
    <%= link_to "← Sınıflar", classes_school_path(@school), class: "ek-card-link" %>
  </nav>

  <span class="ek-eyebrow">İhtiyaç listesi</span>
  <h1 class="ek-section-title"><%= @school.name %></h1>

  <% if @class_list %>
    <article class="ek-panel mt-8 p-6 md:p-8">
      <h2 class="ek-card-title"><%= @class_list.name %></h2>
      <div class="ek-pill-row mt-4">
        <span class="ek-pill">Akademik yıl: <%= @class_list.academic_year %></span>
        <span class="ek-pill">Dönem: <%= @class_list.semester %></span>
        <span class="ek-pill">Versiyon: <%= @class_list.version %></span>
      </div>

      <div class="mt-8 space-y-3">
        <% @class_list.school_class_list_items.each do |item| %>
          <div class="ek-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <h3 class="font-extrabold"><%= item.product.name %></h3>
              <p class="ek-muted"><%= number_to_currency(item.product.price) %> · <%= item.product.point_value %> puan</p>
            </div>
            <div class="text-left md:text-right">
              <p class="ek-price text-2xl"><%= number_to_currency(item.product.price * item.quantity) %></p>
              <p class="ek-muted"><%= item.quantity %> adet</p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-8 pt-6 border-t border-[var(--ek-line)] flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div>
          <p class="ek-muted">Toplam ürün: <strong><%= @class_list.total_items %></strong></p>
          <p class="ek-muted">Toplam tutar: <strong><%= number_to_currency(@class_list.total_amount) %></strong></p>
        </div>
        <%= form_with url: add_class_list_to_cart_school_path(@school, class_list_id: @class_list.id), method: :post do %>
          <%= submit_tag "Tek Tıkla Sepete Ekle", class: "ek-primary-button" %>
        <% end %>
      </div>
    </article>
  <% else %>
    <div class="ek-panel mt-8 p-8">
      <p class="ek-muted">Lütfen bir sınıf seçin ve ilgili dönem listesini görüntüleyin.</p>
      <div class="mt-5"><%= link_to "Sınıf Seç", classes_school_path(@school), class: "ek-primary-button" %></div>
    </div>
  <% end %>
</section>
