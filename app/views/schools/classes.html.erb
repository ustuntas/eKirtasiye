<section>
  <nav class="mb-5">
    <%= link_to "← #{@school.name}", school_path(@school), class: "ek-card-link" %>
  </nav>

  <span class="ek-eyebrow">Sınıf seçimi</span>
  <h1 class="ek-section-title"><%= @school.name %> sınıfları</h1>
  <p class="ek-section-copy">Sınıfınızı seçerek dönem ihtiyaç listesine ulaşın.</p>

  <div class="ek-grid mt-8">
    <% @classes.each do |classroom| %>
      <article class="ek-card">
        <span class="ek-card-kicker">Sınıf</span>
        <h2 class="ek-card-title"><%= classroom.name %></h2>
        <div class="ek-pill-row mt-4">
          <span class="ek-pill"><%= classroom.grade %>. sınıf</span>
          <span class="ek-pill">Şube <%= classroom.section %></span>
        </div>
        <div class="mt-5">
          <%= link_to "İhtiyaç Listesi", class_list_school_path(@school, class_list_id: classroom.id), class: "ek-primary-button" %>
        </div>
      </article>
    <% end %>
  </div>
</section>
