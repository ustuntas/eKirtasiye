<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "eKirtasiye" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="eKirtasiye">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
  </head>

  <body class="ek-body">
    <header class="ek-header">
      <nav class="ek-shell ek-nav">
        <%= link_to root_path, class: "ek-brand" do %>
          <span class="ek-brand-mark">eK</span>
          <span class="ek-brand-text">
            <span class="ek-brand-title">eKirtasiye</span>
            <span class="ek-brand-kicker">Okul alışverişi</span>
          </span>
        <% end %>

        <div class="ek-menu">
          <%= link_to "Kategoriler", categories_path, class: "ek-nav-link" %>
          <%= link_to "Ürünler", products_path, class: "ek-nav-link" %>
          <%= link_to "Okullar", schools_path, class: "ek-nav-link" %>
          <%= link_to cart_path, class: "ek-nav-link ek-cart-link flex items-center gap-1" do %>
            <span>Sepet</span>
            <% if cart_item_count > 0 %>
            <span style="position:relative;display:inline-block;width:20px;height:20px;">
              <svg style="width:20px;height:20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              <span style="position:absolute;top:-8px;right:-8px;background:red;color:white;font-size:10px;padding:2px 4px;border-radius:9999px;"><%= begin cart_item_count rescue 0 end %></span>
            </span>
            <% end %>
          <% end %>
          <% if Current.user %>
            <%= link_to "Hesabım", account_root_path, class: "ek-nav-link" %>
            <%= button_to "Çıkış", session_path, method: :delete, class: "ek-ghost-button" %>
          <% else %>
            <%= link_to "Giriş", new_session_path, class: "ek-primary-button" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% if notice.present? %>
      <div class="ek-shell ek-flash ek-flash-notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="ek-shell ek-flash ek-flash-alert"><%= alert %></div>
    <% end %>

    <main class="ek-shell ek-page">
      <%= yield %>
    </main>

    <footer class="ek-footer">
      <div class="ek-shell flex flex-col md:flex-row gap-3 justify-between items-start md:items-center">
        <p>© <%= Time.current.year %> eKirtasiye. Okul ihtiyaçlarını zarif ve hızlı hale getirir.</p>
        <div class="ek-pill-row">
          <span class="ek-pill">Rails 8.1</span>
          <span class="ek-pill">SQLite</span>
          <span class="ek-pill">Tailwind</span>
        </div>
      </div>
    </footer>
  </body>
</html>
