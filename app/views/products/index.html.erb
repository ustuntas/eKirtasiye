<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Ürünler</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <% @products.each do |product| %>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="bg-gray-200 w-full h-48 rounded flex items-center justify-center">
          <span class="text-gray-500">Resim yok</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-800 mt-4 mb-2"><%= product.name %></h3>
        <p class="text-gray-600 mb-2"><%= number_to_currency(product.price) %></p>
        <p class="text-sm text-gray-500 mb-2">Puan: <%= product.point_value %></p>
        <p class="text-sm text-gray-500 mb-4">Stok: <%= product.stock_quantity %></p>
        <div class="flex gap-2">
          <%= link_to "Detay", product_path(product), class: "text-blue-600 hover:underline" %>
          <%= button_to "Sepete Ekle", add_to_cart_product_path(product), method: :post, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>