<section>
  <div class="ek-section-head">
    <div>
      <span class="ek-eyebrow">Mağaza</span>
      <h1 class="ek-section-title">Ürünler</h1>
      <p class="ek-section-copy">Defterden kaleme, okul listesindeki tüm ihtiyaçlar modern kartlarla hızlıca seçilir.</p>
    </div>
    <%= link_to "Kategorilere Git", categories_path, class: "ek-secondary-button" %>
  </div>

  <div class="ek-grid">
    <% @products.each do |product| %>
      <article class="ek-product-card">
        <div class="ek-product-art">Ürün görseli</div>
        <div class="ek-product-body">
          <h2 class="ek-product-title"><%= product.name %></h2>
          <div class="ek-price"><%= number_to_currency(product.price) %></div>
          <div class="ek-pill-row">
            <span class="ek-pill"><%= product.point_value.to_i %> puan</span>
            <span class="ek-pill"><%= product.stock_quantity %> stok</span>
          </div>
          <div class="flex flex-wrap gap-2 pt-2">
            <%= link_to "Detay", product_path(product), class: "ek-secondary-button" %>
            <%= button_to "Sepete Ekle", add_to_cart_product_path(product), method: :post, class: "ek-primary-button" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
