<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <nav class="mb-4">
      <%= link_to "← Urunler", products_path, class: "text-blue-600 hover:underline" %>
    </nav>
    
    <div class="bg-white rounded-lg shadow p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <div class="bg-gray-200 w-full h-64 rounded-lg flex items-center justify-center">
            <span class="text-gray-500">Resim yok</span>
          </div>
        </div>
        
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= @product.name %></h1>
          <p class="text-gray-600 mb-4"><%= @product.description %></p>
          
          <div class="mb-4">
            <span class="text-3xl font-bold text-blue-600"><%= number_to_currency(@product.price) %></span>
          </div>
          
          <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
            <div>
              <span class="text-gray-500">Puan Degeri:</span>
              <span class="font-semibold"><%= @product.point_value %></span>
            </div>
            <div>
              <span class="text-gray-500">Stok:</span>
              <span class="font-semibold <%= @product.stock_quantity > 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= @product.stock_quantity > 0 ? 'Mevcut' : 'tukendi' %>
              </span>
            </div>
            <div>
              <span class="text-gray-500">Kategori:</span>
              <span class="font-semibold"><%= @product.category.name %></span>
            </div>
          </div>
          
          <div class="flex gap-4">
            <%= button_to "Sepete Ekle", add_to_cart_product_path(@product), method: :post, 
                  class: "bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 font-semibold" %>
            <%= button_to "Favorilere Ekle", add_to_favorites_product_path(@product), method: :post,
                  class: "bg-gray-200 text-gray-800 px-8 py-3 rounded-lg hover:bg-gray-300 font-semibold" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>