<section>
  <nav class="mb-5">
    <%= link_to "← Ürünler", products_path, class: "ek-card-link" %>
  </nav>

  <article class="ek-panel p-5 md:p-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="ek-product-art rounded-[28px] min-h-[360px]">Ürün görseli</div>

      <div>
        <span class="ek-eyebrow"><%= @product.category.name %></span>
        <h1 class="ek-section-title"><%= @product.name %></h1>
        <p class="ek-section-copy"><%= @product.description.presence || "Bu ürün okul ihtiyaç listelerinde kullanılmak üzere hazırlanmıştır." %></p>

        <div class="ek-price mt-6"><%= number_to_currency(@product.price) %></div>

        <div class="ek-pill-row mt-5">
          <span class="ek-pill"><%= @product.point_value.to_i %> puan</span>
          <span class="ek-pill"><%= @product.stock_quantity %> stok</span>
          <span class="ek-pill"><%= @product.stock_quantity.to_i.positive? ? "Mevcut" : "Tükendi" %></span>
        </div>

        <div class="ek-actions mt-7">
          <%= button_to "Sepete Ekle", add_to_cart_product_path(@product), method: :post, class: "ek-primary-button" %>
          <%= button_to "Favorilere Ekle", add_to_favorites_product_path(@product), method: :post, class: "ek-secondary-button" %>
        </div>
      </div>
    </div>
  </article>
</section>
