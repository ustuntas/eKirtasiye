<section class="ek-panel p-6 md:p-8">
  <span class="ek-eyebrow">Kimlik & Roller</span>
  <h1 class="ek-section-title">Kullanıcıları Yönet</h1>
  <p class="ek-section-copy">Kullanıcı rolleri ve hesap kayıtlarını yönetim bakışıyla izleyin.</p>
</section>

<section class="admin-stats-grid mt-8">
  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Kullanıcı</p>
    <p class="admin-stat-value"><%= @users.size %></p>
    <p class="admin-stat-meta">Listelenen kayıt</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Admin</p>
    <p class="admin-stat-value"><%= @admin_count %></p>
    <p class="admin-stat-meta">role: admin</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Okul Admini</p>
    <p class="admin-stat-value"><%= @school_admin_count %></p>
    <p class="admin-stat-meta">role: school_admin</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Müşteri</p>
    <p class="admin-stat-value"><%= @customer_count %></p>
    <p class="admin-stat-meta">role: customer</p>
  </article>
</section>

<section class="ek-panel p-6 mt-8">
  <div class="admin-panel-head">
    <h2>Kullanıcı Listesi</h2>
    <div class="admin-dash-actions">
      <%= link_to "➕ Yeni Kullanıcı", new_admin_user_path, class: "ek-primary-button" %>
      <%= link_to "🏠 Dashboard", admin_root_path, class: "ek-card-link" %>
    </div>
  </div>

  <div class="admin-table-wrap mt-4">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>E-posta</th>
          <th>Rol</th>
          <th>Kayıt Tarihi</th>
          <th>İşlemler</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.email_address %></td>
            <td><span class="ek-pill"><%= user.role %></span></td>
            <td><%= l(user.created_at, format: :short) %></td>
            <td>
              <div class="admin-row-actions">
                <%= link_to "👁️ Detay", admin_user_path(user), class: "ek-pill" %>
                <%= link_to "✏️ Düzenle", edit_admin_user_path(user), class: "ek-pill" %>
                <%= button_to "🗑️ Sil", admin_user_path(user), method: :delete, class: "ek-pill", form: { data: { turbo_confirm: "Bu kullanıcıyı silmek istiyor musunuz?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
