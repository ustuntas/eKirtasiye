<section class="ek-panel p-6 md:p-8">
  <span class="ek-eyebrow">Okul Hesabı Detayı</span>
  <h1 class="ek-section-title">#<%= @school_account.id %></h1>
  <p class="ek-section-copy"><%= @school_account.school&.name %> • <%= @school_account.user&.email_address %></p>

  <div class="admin-dash-actions mt-6">
    <%= link_to icon_text("pencil", "Düzenle"), edit_admin_school_account_path(@school_account), class: "ek-primary-button" %>
    <%= button_to approve_admin_school_account_path(@school_account), method: :post, class: "ek-secondary-button" do %>
      <%= icon_text("check", "Onayla") %>
    <% end %>
    <%= button_to reject_admin_school_account_path(@school_account), method: :post, class: "ek-secondary-button" do %>
      <%= icon_text("x_circle", "Reddet") %>
    <% end %>
    <%= button_to admin_school_account_path(@school_account), method: :delete, class: "ek-secondary-button", form: { data: { turbo_confirm: "Bu okul hesabını silmek istiyor musunuz?" } } do %>
      <%= icon_text("trash", "Sil") %>
    <% end %>
    <%= link_to icon_text("list", "Okul Hesapları"), admin_school_accounts_path, class: "ek-card-link" %>
  </div>
</section>

<section class="admin-stats-grid mt-8">
  <article class="admin-stat-card"><p class="admin-stat-label">Durum</p><p class="admin-stat-value"><%= @school_account.status %></p></article>
  <article class="admin-stat-card"><p class="admin-stat-label">Yetkili</p><p class="admin-stat-value"><%= @school_account.responsible_person %></p></article>
  <article class="admin-stat-card"><p class="admin-stat-label">Telefon</p><p class="admin-stat-value"><%= @school_account.phone %></p></article>
  <article class="admin-stat-card"><p class="admin-stat-label">Tarih</p><p class="admin-stat-value"><%= l(@school_account.created_at, format: :short) %></p></article>
</section>
