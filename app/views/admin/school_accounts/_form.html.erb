<%= form_with model: [:admin, @school_account], class: "grid gap-5" do |form| %>
  <% if @school_account.errors.any? %>
    <div class="ek-flash ek-flash-alert">
      <strong><%= @school_account.errors.count %> hata:</strong>
      <ul class="mt-2 list-disc pl-5">
        <% @school_account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <%= form.label :school_id, "Okul", class: "font-extrabold" %>
      <%= form.collection_select :school_id, School.order(:name), :id, :name, { prompt: "Okul seçin" }, { class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3" } %>
    </div>
    <div>
      <%= form.label :user_id, "Kullanıcı", class: "font-extrabold" %>
      <%= form.collection_select :user_id, User.order(:email_address), :id, :email_address, { prompt: "Kullanıcı seçin" }, { class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3" } %>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <%= form.label :responsible_person, "Yetkili Kişi", class: "font-extrabold" %>
      <%= form.text_field :responsible_person, class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3" %>
    </div>
    <div>
      <%= form.label :phone, "Telefon", class: "font-extrabold" %>
      <%= form.text_field :phone, class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3" %>
    </div>
  </div>

  <div>
    <%= form.label :status, "Durum", class: "font-extrabold" %>
    <%= form.select :status, SchoolAccount.statuses.keys.map { |k| [k, k] }, {}, class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3" %>
  </div>

  <div class="flex gap-3">
    <%= form.button icon_text("save", "Kaydet"), type: :submit, class: "ek-primary-button" %>
    <%= link_to icon_text("back", "Vazgeç"), admin_school_accounts_path, class: "ek-secondary-button" %>
  </div>
<% end %>
