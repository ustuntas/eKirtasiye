<section class="admin-dash-hero ek-panel p-6 md:p-8">
  <span class="ek-eyebrow">Yönetim merkezi</span>
  <h1 class="ek-section-title">Admin Dashboard</h1>
  <p class="ek-section-copy">Sipariş, ürün, okul ve kullanıcı akışlarını tek ekrandan izleyin.</p>

  <div class="admin-dash-actions mt-6">
    <%= link_to "Siparişleri Yönet", admin_orders_path, class: "ek-primary-button" %>
    <%= link_to "Ürünleri Yönet", admin_products_path, class: "ek-secondary-button" %>
    <%= link_to "Okulları Yönet", admin_schools_path, class: "ek-secondary-button" %>
    <%= link_to "Kullanıcıları Yönet", admin_users_path, class: "ek-secondary-button" %>
  </div>
</section>

<section class="admin-stats-grid mt-8">
  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Sipariş</p>
    <p class="admin-stat-value"><%= @total_orders %></p>
    <p class="admin-stat-meta"><%= @pending_orders %> sipariş onay bekliyor</p>
  </article>

  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Ciro</p>
    <p class="admin-stat-value"><%= number_to_currency(@total_revenue, unit: "₺", format: "%u %n") %></p>
    <p class="admin-stat-meta">Bu ay: <%= number_to_currency(@monthly_revenue, unit: "₺", format: "%u %n") %></p>
  </article>

  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Kullanıcı</p>
    <p class="admin-stat-value"><%= @total_users %></p>
    <p class="admin-stat-meta">Aktif ürün: <%= @active_products %></p>
  </article>

  <article class="admin-stat-card">
    <p class="admin-stat-label">Onay Bekleyenler</p>
    <p class="admin-stat-value"><%= @pending_schools_count + @pending_school_accounts_count %></p>
    <p class="admin-stat-meta">Okul: <%= @pending_schools_count %> • Hesap: <%= @pending_school_accounts_count %></p>
  </article>
</section>

<section class="admin-panels-grid mt-8">
  <article class="ek-panel p-6">
    <div class="admin-panel-head">
      <h2>Son Siparişler</h2>
      <%= link_to "Tümünü Gör", admin_orders_path, class: "ek-card-link" %>
    </div>

    <% if @recent_orders.any? %>
      <div class="admin-table-wrap mt-4">
        <table class="admin-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Müşteri</th>
              <th>Durum</th>
              <th>Tutar</th>
              <th>Tarih</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_orders.each do |order| %>
              <tr>
                <td><%= order.id %></td>
                <td><%= order.user&.email_address || "-" %></td>
                <td><span class="ek-pill"><%= order.order_status %></span></td>
                <td><%= number_to_currency(order.total_amount, unit: "₺", format: "%u %n") %></td>
                <td><%= l(order.created_at, format: :short) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="ek-muted mt-4">Henüz sipariş yok.</p>
    <% end %>
  </article>

  <article class="ek-panel p-6">
    <div class="admin-panel-head">
      <h2>Onay Bekleyenler</h2>
      <%= link_to "Okul Hesapları", admin_school_accounts_path, class: "ek-card-link" %>
    </div>

    <div class="admin-split-list mt-4">
      <div>
        <h3>Okullar</h3>
        <% if @pending_schools.any? %>
          <ul>
            <% @pending_schools.each do |school| %>
              <li>
                <span><%= school.name %></span>
                <%= link_to "İncele", admin_school_path(school), class: "ek-pill" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="ek-muted">Bekleyen okul yok.</p>
        <% end %>
      </div>

      <div>
        <h3>Okul Hesapları</h3>
        <% if @pending_school_accounts.any? %>
          <ul>
            <% @pending_school_accounts.each do |account| %>
              <li>
                <span><%= account.user&.email_address || "Kullanıcı yok" %></span>
                <%= link_to "İncele", admin_school_account_path(account), class: "ek-pill" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="ek-muted">Bekleyen okul hesabı yok.</p>
        <% end %>
      </div>
    </div>
  </article>
</section>

<section class="ek-panel p-6 mt-8">
  <div class="admin-panel-head">
    <h2>Stok Uyarıları</h2>
    <%= link_to "Ürünlere Git", admin_products_path, class: "ek-card-link" %>
  </div>

  <% if @low_stock_products.any? %>
    <div class="admin-low-stock-grid mt-4">
      <% @low_stock_products.each do |product| %>
        <article class="admin-low-stock-card">
          <p class="admin-low-stock-name"><%= product.name %></p>
          <p class="admin-low-stock-meta">SKU: <%= product.sku %></p>
          <p class="admin-low-stock-count">Kalan stok: <strong><%= product.stock_quantity %></strong></p>
          <%= link_to "Düzenle", edit_admin_product_path(product), class: "ek-pill" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="ek-muted mt-4">Kritik stok seviyesi altında ürün bulunmuyor.</p>
  <% end %>
</section>
