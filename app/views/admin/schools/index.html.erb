<section class="ek-panel p-6 md:p-8">
  <span class="ek-eyebrow">Kurumsal</span>
  <h1 class="ek-section-title">Okul Yönetimi</h1>
  <p class="ek-section-copy">Okul başvurularını ve durumlarını merkezi olarak yönetin.</p>
</section>

<section class="admin-stats-grid mt-8">
  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Okul</p>
    <p class="admin-stat-value"><%= @schools.size %></p>
    <p class="admin-stat-meta">Listelenen kayıt</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Onaylı</p>
    <p class="admin-stat-value"><%= @approved_schools_count %></p>
    <p class="admin-stat-meta">approved</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Bekleyen</p>
    <p class="admin-stat-value"><%= @pending_schools_count %></p>
    <p class="admin-stat-meta">pending</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Reddedilen</p>
    <p class="admin-stat-value"><%= @rejected_schools_count %></p>
    <p class="admin-stat-meta">rejected</p>
  </article>
</section>

<section class="ek-panel p-6 mt-8">
  <div class="admin-panel-head">
    <h2>Okul Listesi</h2>
    <div class="admin-dash-actions">
      <%= link_to "Yeni Okul", new_admin_school_path, class: "ek-primary-button" %>
      <%= link_to "Dashboard", admin_root_path, class: "ek-card-link" %>
    </div>
  </div>

  <div class="admin-table-wrap mt-4">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Okul</th>
          <th>E-posta</th>
          <th>Telefon</th>
          <th>Vergi No</th>
          <th>Durum</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @schools.each do |school| %>
          <tr>
            <td><%= school.name %></td>
            <td><%= school.email %></td>
            <td><%= school.phone.presence || "-" %></td>
            <td><%= school.tax_number %></td>
            <td><span class="ek-pill"><%= school.status %></span></td>
            <td><%= link_to "Detay", admin_school_path(school), class: "ek-pill" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
