<section class="ek-panel p-6 md:p-8">
  <span class="ek-eyebrow">Operasyon</span>
  <h1 class="ek-section-title">Sipariş Yönetimi</h1>
  <p class="ek-section-copy">Sipariş akışını yönetin, durumları takip edin ve hızlıca detaylara gidin.</p>
</section>

<section class="admin-stats-grid mt-8">
  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Sipariş</p>
    <p class="admin-stat-value"><%= @orders.size %></p>
    <p class="admin-stat-meta">Listelenen kayıt</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Bekleyen Sipariş</p>
    <p class="admin-stat-value"><%= @pending_orders_count %></p>
    <p class="admin-stat-meta">Onay/işlem bekliyor</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Ödenen Sipariş</p>
    <p class="admin-stat-value"><%= @paid_orders_count %></p>
    <p class="admin-stat-meta">payment_status: paid</p>
  </article>
  <article class="admin-stat-card">
    <p class="admin-stat-label">Toplam Ciro</p>
    <p class="admin-stat-value"><%= number_to_currency(@total_revenue, unit: "₺", format: "%u %n") %></p>
    <p class="admin-stat-meta">Sipariş toplamları</p>
  </article>
</section>

<section class="ek-panel p-6 mt-8">
  <div class="admin-panel-head">
    <h2>Sipariş Listesi</h2>
    <%= link_to "Dashboard", admin_root_path, class: "ek-card-link" %>
  </div>

  <div class="admin-table-wrap mt-4">
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Müşteri</th>
          <th>Sipariş Durumu</th>
          <th>Ödeme</th>
          <th>Tutar</th>
          <th>Tarih</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.user&.email_address || "-" %></td>
            <td><span class="ek-pill"><%= order.order_status %></span></td>
            <td><span class="ek-pill"><%= order.payment_status %></span></td>
            <td><%= number_to_currency(order.total_amount, unit: "₺", format: "%u %n") %></td>
            <td><%= l(order.created_at, format: :short) %></td>
            <td><%= link_to "Detay", admin_order_path(order), class: "ek-pill" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
