<section>
  <nav class="mb-5">
    <%= link_to "← Kategoriler", categories_path, class: "ek-card-link" %>
  </nav>

  <span class="ek-eyebrow">Kategori ürünleri</span>
  <h1 class="ek-section-title"><%= @category.name %></h1>
  <p class="ek-section-copy">Bu kategoriye ait aktif ürünleri inceleyin ve sepetinize ekleyin.</p>

  <% if @products.any? %>
    <div class="ek-grid mt-8">
      <% @products.each do |product| %>
        <article class="ek-product-card">
          <div class="ek-product-art">Ürün görseli</div>
          <div class="ek-product-body">
            <h2 class="ek-product-title"><%= product.name %></h2>
            <div class="ek-price"><%= number_to_currency(product.price) %></div>
            <div class="ek-pill-row">
              <span class="ek-pill"><%= product.point_value.to_i %> puan</span>
              <span class="ek-pill"><%= product.stock_quantity %> stok</span>
            </div>
            <%= link_to "Detay", product_path(product), class: "ek-card-link" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="ek-panel mt-8 p-8">
      <p class="ek-muted">Bu kategoride ürün bulunamadı.</p>
    </div>
  <% end %>
</section>
