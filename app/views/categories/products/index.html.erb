    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% @products.each do |product| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
          <div class="w-full h-48 bg-gray-100 flex items-center justify-center">
            <span class="text-gray-400">Resim yok</span>
          </div>
          <div class="p-4">
            <%= link_to product.name, product_path(product), class: "font-medium text-gray-900 hover:text-blue-600" %>
            <p class="text-lg font-bold text-blue-600 mt-2"><%= number_to_currency(product.price) %></p>
            <% if product.point_value.to_i > 0 %>
              <p class="text-sm text-green-600">+<%= product.point_value %> puan</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">Bu kategoride urun bulunamadi.</p>
  <% end %>
