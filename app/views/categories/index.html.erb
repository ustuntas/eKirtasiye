<section>
  <span class="ek-eyebrow">Katalog</span>
  <h1 class="ek-section-title">Kategoriler</h1>
  <p class="ek-section-copy">Okul alışverişini bölümlere ayıran sade ve anlaşılır kategori yapısı.</p>

  <div class="ek-grid mt-8">
    <% @categories.each_with_index do |category, index| %>
      <article class="ek-card">
        <span class="ek-card-kicker">Kategori <%= index + 1 %></span>
        <h2 class="ek-card-title"><%= category.name %></h2>
        <p class="ek-muted"><%= category.products.active.count %> ürün listeleniyor.</p>
        <div class="mt-5">
          <%= link_to "Ürünleri Göster", category_products_path(category), class: "ek-card-link" %>
        </div>
      </article>
    <% end %>
  </div>
</section>
