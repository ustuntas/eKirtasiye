<div>
  <h1 class="font-bold text-4xl">Categories#index</h1>
  <div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Kategoriler</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @categories.each do |category| %>
      <div class="bg-white rounded-lg shadow p-6 hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= category.name %></h3>
        <p class="text-gray-600 mb-4"><%= category.products.active.count %> ürün</p>
        <%= link_to "Ürünleri Göster", category_products_path(category), class: "text-blue-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
</div>
