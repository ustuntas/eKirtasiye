<div class="container mx-auto px-4 py-8">
  <nav class="mb-4">
    <%= link_to "← Kategoriler", categories_path, class: "text-blue-600 hover:underline" %>
  </nav>
  
  <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @category.name %></h1>
  <p class="text-gray-600 mb-8"><%= @category.description %></p>
  
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <% @products.each do |product| %>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="bg-gray-200 w-full h-48 rounded flex items-center justify-center">
          <span class="text-gray-500">Resim yok</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-800 mt-4 mb-2"><%= product.name %></h3>
        <p class="text-gray-600 mb-2"><%= number_to_currency(product.price) %></p>
        <p class="text-sm text-gray-500 mb-4">Stok: <%= product.stock_quantity %></p>
        <%= link_to "Detay", product_path(product), class: "text-blue-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>