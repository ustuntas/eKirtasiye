<section class="max-w-xl mx-auto">
  <div class="ek-panel p-6 md:p-8">
    <span class="ek-eyebrow">Güvenli giriş</span>
    <h1 class="ek-section-title">Hesabınıza giriş yapın</h1>
    <p class="ek-section-copy">Siparişlerinizi, okul listelerinizi ve puanlarınızı takip etmek için devam edin.</p>

    <%= form_with url: session_url, class: "mt-8 grid gap-5" do |form| %>
      <div>
        <%= form.label :email_address, "E-posta", class: "font-extrabold" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "ornek@ekirtasiye.com", value: params[:email_address], class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3 outline-none focus:border-[var(--ek-coral)]" %>
      </div>

      <div>
        <%= form.label :password, "Şifre", class: "font-extrabold" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Şifreniz", maxlength: 72, class: "mt-2 w-full rounded-2xl border border-[var(--ek-line)] bg-white px-4 py-3 outline-none focus:border-[var(--ek-coral)]" %>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <%= form.submit "Giriş Yap", class: "ek-primary-button" %>
        <%= link_to "Şifremi unuttum", new_password_path, class: "ek-card-link" %>
      </div>
    <% end %>
  </div>
</section>
