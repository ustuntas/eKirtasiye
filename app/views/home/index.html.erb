<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>eKirtasiye - Okul Kirtasiyesi Online Satis</title>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-gray-50">
  <header class="bg-white shadow-sm">
    <nav class="container mx-auto px-4 py-3 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-blue-600">eKirtasiye</h1>
      <div class="space-x-4">
        <%= link_to "Ana Sayfa", root_path, class: "text-gray-700 hover:text-blue-600" %>
        <%= link_to "Kategoriler", categories_path, class: "text-gray-700 hover:text-blue-600" %>
        <%= link_to "Urunler", products_path, class: "text-gray-700 hover:text-blue-600" %>
        <%= link_to "Okullar", schools_path, class: "text-gray-700 hover:text-blue-600" %>
        <%= link_to "Sepet", cart_path, class: "text-gray-700 hover:text-blue-600" %>
        <% if Current.user %>
          <%= link_to "Hesabim", account_root_path, class: "text-gray-700 hover:text-blue-600" %>
          <%= button_to "Cikis", session_path, method: :delete, class: "text-red-600 hover:text-red-800" %>
        <% else %>
          <%= link_to "Giris", new_session_path, class: "text-blue-600 hover:text-blue-800" %>
          <%= link_to "Kayit", "#", class: "text-blue-600 hover:text-blue-800" %>
        <% end %>
      </div>
    </nav>
  </header>

  <main class="container mx-auto px-4 py-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Hosgeldiniz!</h2>
      <p class="text-xl text-gray-600 mb-8">Okul kirtasiyesi urunlerini online kesfedin</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-6 rounded-lg shadow">
          <h3 class="text-lg font-semibold mb-2">Kategoriler</h3>
          <p class="text-gray-600"><%= Category.count %> kategori</p>
          <%= link_to "Kategorileri Goruntule", categories_path, class: "text-blue-600 hover:underline" %>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
          <h3 class="text-lg font-semibold mb-2">Urunler</h3>
          <p class="text-gray-600"><%= Product.active.count %> urun</p>
          <%= link_to "Urunleri Goruntule", products_path, class: "text-blue-600 hover:underline" %>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
          <h3 class="text-lg font-semibold mb-2">Okullar</h3>
          <p class="text-gray-600"><%= School.approved.count %> okul</p>
          <%= link_to "Okullari Goruntule", schools_path, class: "text-blue-600 hover:underline" %>
        </div>
      </div>

      <div class="bg-blue-50 p-8 rounded-lg">
        <h3 class="text-2xl font-bold text-blue-900 mb-4">Demo Bilgileri</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          <div class="bg-white p-4 rounded">
            <h4 class="font-semibold">Admin</h4>
            <p class="text-sm text-gray-600">Email: admin@ekirtasiye.com</p>
            <p class="text-sm text-gray-600">Sifre: password123</p>
          </div>
          <div class="bg-white p-4 rounded">
            <h4 class="font-semibold">Okul Yoneticisi</h4>
            <p class="text-sm text-gray-600">Email: okul@ekirtasiye.com</p>
            <p class="text-sm text-gray-600">Sifre: password123</p>
          </div>
          <div class="bg-white p-4 rounded">
            <h4 class="font-semibold">Musteri</h4>
            <p class="text-sm text-gray-600">Email: musteri@ekirtasiye.com</p>
            <p class="text-sm text-gray-600">Sifre: password123</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-gray-800 text-white py-6 mt-12">
    <div class="container mx-auto px-4 text-center">
      <p>&copy; 2026 eKirtasiye. Tum haklari saklidir.</p>
    </div>
  </footer>
</body>
</html>
